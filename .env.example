# ─────────────────────────────────────────────────────────────────────────────
# Discord Bot Skeleton - Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# From https://discord.com/developers/applications → your app → Bot
DISCORD_BOT_TOKEN=your-bot-token-here

# From https://discord.com/developers/applications → your app → OAuth2
DISCORD_CLIENT_ID=your-client-id-here
DISCORD_CLIENT_SECRET=your-client-secret-here

# Must match a redirect URI you added in the Discord developer portal.
# For local dev: http://localhost:8080/auth/callback
DISCORD_REDIRECT_URI=http://localhost:8080/auth/callback

# Web server port
PORT=8080

# Random string used to sign session cookies. Must be set in production.
# If omitted, a random key is generated at startup (sessions won't survive restarts).
SECRET_KEY=change-me-to-a-long-random-string

# Set to "true" in production when serving over HTTPS.
# This adds the Secure flag to cookies so they are never sent over plain HTTP.
SECURE_COOKIES=false

# Tenor API key - no longer required.
# Prishe uses Tenor's built-in public key by default.
# The GIF search query is configurable per-server via the web dashboard.
# TENOR_API_KEY=

# Path to the birthday data file.
# On Railway, mount a Volume at e.g. /data and set this to /data/birthdays.json
# so birthdays survive redeploys. Defaults to birthdays.json in the working directory.
BIRTHDAY_DATA_FILE=birthdays.json

# Path to the roles data file.
# Same advice applies: mount a Volume on Railway to survive redeploys.
ROLES_DATA_FILE=roles.json

# Path to the raid sign-up data file.
# Mount a Volume on Railway at e.g. /data and set this to /data/raids.json.
RAID_DATA_FILE=raids.json

# Directory where FF14 job/role icons are stored after running:
#   go run ./scripts/download_icons
# Defaults to web/static/icons/ffxiv. On Railway, mount a Volume and point
# both ICONS_DIR and the script's ICONS_DIR variable at the same path.
ICONS_DIR=web/static/icons/ffxiv

# Public base URL of the web server (no trailing slash).
# When set, the bot uses locally-hosted icon URLs in Discord embeds instead of
# referencing the upstream CDN. Leave empty for local dev without a public URL.
# Example: https://mybot.up.railway.app
BASE_URL=
